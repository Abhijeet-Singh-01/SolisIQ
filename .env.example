# =========================================================
# SolisIQ / AI Solar Advisor - Environment Variables Example
# Copy this file to .env and fill in your values
# =========================================================

# --- Flask Backend Configuration ---
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-secret-key-here
PORT=5000

# --- Database Configuration (Aiven MySQL / Local MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=11461
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_CONNECTION_TIMEOUT=5
USE_SSL=true

# --- CORS Configuration ---
CORS_ORIGINS=*

# --- Optional Admin Credentials (Auto-seeded if admins table is empty) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@solisiq.local

# --- Frontend API Base URL ---
REACT_APP_API_URL=https://solis-iq-backend.onrender.com
VITE_API_URL=https://solis-iq-backend.onrender.com
